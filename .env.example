# Local-only authentication. Generate two distinct random values of at least
# 32 characters and enter the same values when VS Code prompts for each token.
AUTH_MODE=local
DEV_MOCK_USER_ONE_TOKEN=
DEV_MOCK_USER_TWO_TOKEN=

# For Google OAuth instead, set AUTH_MODE=oauth and configure these values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MCP_BASE_URL=http://127.0.0.1:8000